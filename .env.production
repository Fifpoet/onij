# 生产构建专用（pnpm build / build:release 时加载，会打进前端包）
# 勿填 127.0.0.1；HTTPS 下 API / 网易走同源反代，避免混合内容
VITE_SERVER_URL=https://onij.fun/go
VITE_NETEASE_URL=https://onij.fun/netease/
# 家宽路由器常解析不到 static.onij.fun，HTML 继续同源 /assets/
# VITE_PUBLIC_PATH=https://static.onij.fun/
# 取链同源反代 music.gdstudio.org（播放器 api.php，需 crc32 签名）
VITE_GDSTUDIO_MUSIC_URL=https://onij.fun/gdstudio

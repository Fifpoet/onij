{
  "manifest_version": 3,
  "name": "音乐信息提取器",
  "version": "1.0.0",
  "description": "监听并提取音乐网站的信息",
  
  "permissions": [
    "webRequest",
    "storage",
    "activeTab"
  ],
  
  "content_scripts": [
    {
      "matches": ["https://zm.i9mr.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  
  "host_permissions": [
    "https://zm.i9mr.com/*"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "音乐信息提取器"
  },
  
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}